<IfModule mod_rewrite.c>
    RewriteEngine On

    # Impede que o Apache tente adivinhar caminhos se o arquivo não existir
    Options -MultiViews

    # Redireciona tudo o que não for um arquivo real físico para a pasta public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>